generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Hierarquia de Patentes
enum FounderClass {
  SUPREMO
  ELITE
  SENIOR
  PLENO
  JUNIOR
  TRAINEE
}

// Ledger Primário (Cap Table e Guilhotina)
model Founder {
  id               String       @id @default(uuid())
  email            String       @unique
  patentClass      FounderClass @default(TRAINEE)
  hp               Int          @default(100)
  totalSweatPoints Int          @default(0)
  isGuillotined    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("founders")
}